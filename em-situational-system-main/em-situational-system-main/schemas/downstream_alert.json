{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DownstreamAlert",
  "description": "输出给数据变传管控等下游模块的结构化信息",
  "type": "object",
  "required": ["alert_id", "alert_type", "timestamp", "risk_level"],
  "properties": {
    "alert_id": { "type": "string" },
    "alert_type": { "enum": ["realtime", "predictive", "spectrum_conflict", "link_degradation"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "risk_level": { "enum": ["normal", "mild", "moderate", "severe", "unavailable"] },
    "affected_links": { "type": "array", "items": { "type": "string" } },
    "affected_freq_hz": { "type": "array", "items": { "type": "number" } },
    "recommended_freq_hz": { "type": "number" },
    "prediction_confidence": { "type": "number" },
    "trace": {
      "type": "object",
      "properties": {
        "jammer_ids": { "type": "array" },
        "reason": { "type": "string" },
        "rules_applied": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
