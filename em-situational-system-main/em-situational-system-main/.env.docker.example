# Base images: can point to Docker Hub, a mirror, or a local registry.
PYTHON_BASE_IMAGE=python:3.11-slim
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine

# Python package mirrors. Leave blank when using the public index or local wheelhouse.
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=

# Runtime service configuration.
POSTGRES_USER=ems
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=ems
DATABASE_URL=postgresql://ems:replace-with-a-local-password@postgres:5432/ems
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
STATIC_DIR=/static

